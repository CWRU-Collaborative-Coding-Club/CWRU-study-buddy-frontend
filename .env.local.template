# Supabase (browser + PostgREST). Use the anon JWT (eyJ...) or a publishable key from the dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt
# Optional; if set, middleware and the auth helper prefer this over the anon key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Server-only (never expose in client bundles). Backend Docker / Python uses these names:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Requests
NEXT_PUBLIC_ONLINE_BASE_URL=https://cwru-studybuddy.com
NEXT_PUBLIC_LOCAL_BASE_URL=https://localhost

NEXT_PUBLIC_API_VERSION=v1

NEXT_PUBLIC_DEV_ENVIRONMENT=dev
NEXT_PUBLIC_PROD_ENVIRONMENT=prod

# Set this to TRUE if you want to use the local backend
NEXT_PUBLIC_LOCAL_BACKEND=FALSE